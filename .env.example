# ═══════════════════════════════════════════
# Chatbot RAG — Configurazione
# ═══════════════════════════════════════════

# ── Qdrant ─────────────────────────────────
# Server mode (default):
#   QDRANT_HOST=qdrant
#   QDRANT_PORT=6333
#
# Local mode (singola istanza, Railway):
#   QDRANT_LOCAL_PATH=/data/qdrant
#   (se impostato, ignora QDRANT_HOST/PORT e usa Qdrant embedded su file)

QDRANT_HOST=qdrant
QDRANT_PORT=6333
# QDRANT_LOCAL_PATH=/data/qdrant

# ── Backend ────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM Provider ──────────────────────────
# "openai" o "ollama"
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# ── Ollama (opzionale, solo se LLM_PROVIDER=ollama) ──
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Frontend (build-time) ─────────────────
# Se vuoto, le API vengono chiamate sullo stesso host (stessa origine)
VITE_API_URL=
