# ═══════════════════════════════════════════
# Chatbot RAG — Configurazione
# ═══════════════════════════════════════════

# ── Qdrant ─────────────────────────────────
# Server mode (default):
#   QDRANT_HOST=qdrant
#   QDRANT_PORT=6333
#
# Local mode (singola istanza, Railway):
#   QDRANT_LOCAL_PATH=/data/qdrant
#   (se impostato, ignora QDRANT_HOST/PORT e usa Qdrant embedded su file)

QDRANT_HOST=qdrant
QDRANT_PORT=6333
# QDRANT_LOCAL_PATH=/data/qdrant

# ── Backend ────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM Provider (Chat) ───────────────────
# "openai" o "ollama"
LLM_PROVIDER=openai
#
# Chiave per il provider chat
OPENAI_API_KEY=sk-...
#
# URL base del provider API (vuoto = default OpenAI)
# OPENAI_BASE_URL=
#
# Modello per chat (default: gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Embedding Provider (opzionale, separato) ──
# Se non impostati, usa gli stessi valori del provider chat.
# Utile quando chat e embedding usano provider diversi
# (es. Ollama per chat + OpenAI per embedding).
#
# OPENAI_EMBEDDING_API_KEY=sk-...
# OPENAI_EMBEDDING_BASE_URL=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Ollama
# ── Ollama (opzionale, solo se LLM_PROVIDER=ollama) ──
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Frontend (build-time) ─────────────────
# Se vuoto, le API vengono chiamate sullo stesso host (stessa origine)
VITE_API_URL=
