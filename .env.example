# Qdrant server (compose)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# Legacy embedded mode is incompatible with the dedicated import worker:
# DATA_DIR=/data
# QDRANT_LOCAL_PATH=/data/qdrant

# Local, structure-aware PDF extraction. Explicit rollback: PDF_EXTRACTOR=pypdf.
PDF_EXTRACTOR=docling
PDF_MAX_PAGES=300
PDF_CONVERSION_TIMEOUT=180
IMPORT_WORKER_POLL_SECONDS=3
IMPORT_WORKER_LEASE_SECONDS=600
# Contesto gerarchico: sezione/articolo per fonte e budget totale della domanda.
RETRIEVAL_SECTION_MAX_CHARS=18000
RETRIEVAL_TOTAL_MAX_CHARS=48000
RETRIEVAL_NEIGHBOR_CHUNKS=1
# Optional pre-downloaded Docling layout/table model directory.
# DOCLING_ARTIFACTS_PATH=/opt/docling-models

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash

EMBEDDING_PROVIDER=ollama
# Mac mini, LAN; reachable from the backend container
OLLAMA_BASE_URL=http://192.168.1.22:11434
OLLAMA_CHAT_MODEL=gpt-oss:20b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=

# Supabase: public values only; never use service_role or sb_secret here.
SUPABASE_URL=https://supabase.intecha.dev
SUPABASE_PUBLISHABLE_KEY=sb_publishable_eOn6jCKOJYVPzRh39CQIFJ_0zYEU4iV
SUPABASE_JWT_ISSUER=https://supabase.intecha.dev/auth/v1
VITE_SUPABASE_URL=https://supabase.intecha.dev
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_eOn6jCKOJYVPzRh39CQIFJ_0zYEU4iV

# Server only: required by admin APIs and the import worker; never VITE_ or committed.
SUPABASE_ADMIN_KEY=
