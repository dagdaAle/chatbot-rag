# Chiave Fernet per cifrare le tabelle di corrispondenza. Se la perdi, i
# pseudonimi già emessi non si possono più invertire.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ANONYMIZER_KEY=
# Token condiviso col backend (header X-Anonymizer-Token). Obbligatorio, anche sulla rete interna.
ANONYMIZER_TOKEN=
GLINER_MODEL=urchade/gliner_multi_pii-v1
GLINER_THRESHOLD=0.5
# auto | cuda | cpu
DEVICE=auto

MAPPING_TTL_SECONDS=900
